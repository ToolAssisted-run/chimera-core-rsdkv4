{
  "coreName": "rsdkv4",
  "systemNames": {
    "Sonic1": "Sonic the Hedgehog (2013)",
    "Sonic2": "Sonic the Hedgehog 2 (2013)"
  },
  "kind": "game",
  "machineSetting": "game",
  "machines": [
    {
      "id": "Sonic1",
      "label": "Sonic the Hedgehog (2013 remaster, Retro Engine v4)",
      "when": [
        "sonic1"
      ]
    },
    {
      "id": "Sonic2",
      "label": "Sonic the Hedgehog 2 (2013 remaster, Retro Engine v4)",
      "when": [
        "sonic2"
      ]
    }
  ],
  "_machines_note": "The Retro Engine v4 decompilation plays the 2013 remasters of Sonic the Hedgehog and Sonic the Hedgehog 2, each from its own data file, which the project brings as firmware. The game setting is what the project records; the data file it needs follows from it.",
  "author": "Christian Whitehead (Retro Engine v4); the RSDKv4 decompilation by Rubberduckycooly and st×tic; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-rsdkv4",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's own memory and Mesa's (its textures: the menus' pictures and the stage's screen) on the heap; the game's data file in sealed memory, read-only after Init and so in no savestate (Sonic 2's Android data is 43 MiB); C++'s, SDL's and Mesa's larger allocations mmap'd. A savestate of Sonic 1 in Green Hill is 29 MB, most of it the OpenGL's textures.",
  "memoryLayoutMiB": [
    256,
    1024,
    4,
    4,
    512
  ],
  "video": {
    "_comment": "What the engine's OpenGL draws (Mesa's softpipe, compiled into the core): its software screen as a texture, with the remasters' menus and 3D title over it - 240 lines and as wide as the Screen Width setting (424 by default), times the Render Scale setting.",
    "width": 848,
    "height": 480,
    "virtualWidth": 424,
    "virtualHeight": 240,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The engine's own mixer (its music, decoded from the data file's Ogg Vorbis tracks, and its sound effects), run for exactly one sixtieth of a second each frame: 735 stereo samples at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 735,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Retro Engine v4",
    "_comment": "The engine's fourteen inputs: the pad's directions, A, B, C, X, Y, Z, L, R, Start and Select. Sonic 1 and 2 jump with A, B or C and pause with Start; the remasters' menus move with the directions and choose with A (or Start). The engine reads them at the start of each frame from the keyboard, where they are upstream's keys: the arrows, Z X C, A S D, Q E, Enter and Tab.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 A",
      "P1 B",
      "P1 C",
      "P1 X",
      "P1 Y",
      "P1 Z",
      "P1 L",
      "P1 R",
      "P1 Start",
      "P1 Select"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "A": "A",
      "B": "B",
      "C": "C",
      "X": "X",
      "Y": "Y",
      "Z": "Z",
      "L": "l",
      "R": "r",
      "Start": "S",
      "Select": "s"
    }
  },
  "settings": [
    {
      "name": "game",
      "display": "Game",
      "type": "enum",
      "options": [
        "sonic1",
        "sonic2"
      ],
      "default": "sonic1",
      "description": "Which game this project plays (it is the System in Chimera): \"sonic1\" is Sonic the Hedgehog, \"sonic2\" Sonic the Hedgehog 2, each the 2013 remaster. The game decides which data file the project needs."
    },
    {
      "name": "language",
      "display": "Language",
      "type": "enum",
      "options": [
        "en",
        "fr",
        "it",
        "de",
        "es",
        "ja",
        "pt",
        "ru",
        "ko",
        "zh",
        "zhs"
      ],
      "default": "en",
      "description": "The language of the menus and the game's texts (the engine's Language setting): English, French, Italian, German, Spanish, Japanese, Portuguese, Russian, Korean, Chinese (traditional) or Chinese (simplified). The game reads it, so a movie records it."
    },
    {
      "name": "screenWidth",
      "display": "Screen Width",
      "type": "int",
      "default": 424,
      "min": 320,
      "max": 424,
      "description": "How many pixels wide the screen is (the engine's ScreenWidth setting). 424 is upstream's default, a 16:9 screen; 320 is the 4:3 screen of the Mega Drive originals. The width changes how far ahead the player sees and which objects are awake, so it changes the game, and a movie records it."
    },
    {
      "name": "skipStartMenu",
      "display": "Skip Start Menu",
      "type": "bool",
      "default": false,
      "description": "Starts the game itself at power-on, without the remaster's start menu (the engine's SkipStartMenu setting): no SEGA and Christian Whitehead screens, no 3D title, no save select. Off by default, as upstream. It changes what the first frames are, so a movie records it."
    },
    {
      "name": "renderScale",
      "display": "Render Scale",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 2,
      "description": "Draws the picture at once (1) or twice (2) the screen's size each way (the engine's WindowScale setting). At 2 the menus, the 3D title and the touch controls are sharper; the stages are the same pixels made bigger. It changes the picture only."
    },
    {
      "name": "randomSeed",
      "display": "Random Seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "The number the engine's random numbers start from. The engine takes it from the clock when it starts (time()); here it is this number, so a movie plays the same every time. A movie records it."
    }
  ],
  "firmware": [
    {
      "id": "Sonic1.rsdk",
      "display": "Sonic the Hedgehog (2013) data file",
      "description": "The data file of Sonic the Hedgehog's 2013 remaster: everything the game is. The copy that was checked is the Android release's: in its APK it is assets/Data.rsdk.xmf, which is this file under another name. You have to supply it, because this package includes none of the game's files. A file of your own can be used in its place, and the project then records its hash.",
      "sha1": "3B49570C26B469B05BD01EF43995310E7066989E",
      "name": "Data.rsdk",
      "requiredWhen": {
        "setting": "game",
        "is": "sonic1"
      }
    },
    {
      "id": "Sonic2.rsdk",
      "display": "Sonic the Hedgehog 2 (2013) data file",
      "description": "The data file of Sonic the Hedgehog 2's 2013 remaster: everything the game is. The copy that was checked is the Android release's: in its APK it is assets/Data.rsdk.xmf, which is this file under another name. You have to supply it, because this package includes none of the game's files. A file of your own can be used in its place, and the project then records its hash.",
      "sha1": "8C7B963B3591C27E43DC27CD25B3C07735BE575C",
      "name": "Data.rsdk",
      "requiredWhen": {
        "setting": "game",
        "is": "sonic2"
      }
    }
  ]
}
